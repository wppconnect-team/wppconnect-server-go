# Copy to .env for Docker Compose, or enter these values in Portainer.
# Generate a private secret: openssl rand -hex 24
SECRET_KEY=
WPP_SERVER_GO_TAG=0.1.2
WPP_SERVER_GO_PORT=21465
# Optional reachable HTTP(S) receiver. localhost would be the API container.
WEBHOOK_URL=
# The following settings require an image built from this checkout.
AUTO_RESTORE_SESSIONS=true
SHUTDOWN_TIMEOUT=25s
WEBHOOK_WORKERS=2
WEBHOOK_QUEUE_SIZE=256
WEBHOOK_ATTEMPTS=4
WEBHOOK_TIMEOUT=10s
