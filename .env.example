# Copy to .env for Docker Compose, or enter these values in Portainer.
# Generate a private secret: openssl rand -hex 24
SECRET_KEY=
WPP_SERVER_GO_TAG=0.1.3
WPP_SERVER_GO_PORT=21465
# Optional reachable HTTP(S) receiver. localhost would be the API container.
WEBHOOK_URL=
# The following settings are available in published images from 0.1.3 onward.
AUTO_RESTORE_SESSIONS=true
SHUTDOWN_TIMEOUT=25s
WEBHOOK_WORKERS=2
WEBHOOK_QUEUE_SIZE=256
WEBHOOK_ATTEMPTS=4
WEBHOOK_TIMEOUT=10s

# Source expansion below requires an image built from this change or a later release.
# ADMIN_TOKEN is separate from SECRET_KEY and must have at least 32 bytes.
ADMIN_TOKEN=
ENABLE_MANAGER=true
HISTORY_RETENTION_DAYS=30
HISTORY_MAX_MESSAGES=100000
HISTORY_MAX_BYTES=268435456
OUTBOX_RETENTION_DAYS=7
OUTBOX_MAX_EVENTS=100000
OUTBOX_MAX_BYTES=134217728
# Durable targets are optional. WEBHOOK_QUEUE_SIZE is a legacy compatibility setting.
NATS_URL=
AMQP_URL=
# Pre-existing private S3 bucket, no public policy is applied by the server.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_USE_SSL=true
MEDIA_RETENTION_DAYS=7
# Experimental account/client dependent delivery, off by default.
ENABLE_EXPERIMENTAL_INTERACTIVES=false
